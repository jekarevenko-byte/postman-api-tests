    {
      "name": "Scenario - chained requests",
      "item": [
        {
          "name": "1. Get users and remember the first id",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Content-Type is JSON\", () => pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\"));",
                  "const users = pm.response.json();",
                  "pm.test(\"Users list is not empty\", () => pm.expect(users.length).to.be.above(0));",
                  "// Save a value for the following requests of the scenario",
                  "pm.collectionVariables.set(\"flowUserId\", users[0].id);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/users",
              "host": [
                "{{baseUrl}}"
              ],
